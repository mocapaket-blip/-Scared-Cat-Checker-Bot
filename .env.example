# ==== Telegram ====
BOT_TOKEN=123456:AAAA-your-bot-token
ADMIN_ID=123456789
GROUP_ID=-1001234567890

# ==== TON ====
NFT_COLLECTION_ADDRESS=EQATuUGdvrjLvTWE5ppVFOVCqU2dlCLUnKTsu0n1JYm9la10
TONAPI_KEY=
TONAPI_BASE_URL=https://tonapi.io

# ==== TON Connect ====
# Манифест ОБЯЗАТЕЛЬНО должен быть выложен по публичному HTTPS-адресу.
# Самый простой вариант: GitHub Pages / любой статический хостинг.
# В файле tonconnect-manifest.json замените URL/иконку на свои и выложите его.
MANIFEST_URL=https://example.com/tonconnect-manifest.json

# ==== Verification ====
VERIFICATION_DEADLINE_DAYS=7

# ==== Gifts ====
# Подстроки для поиска нужного подарка (в lowercase, через запятую)
GIFT_KEYWORDS=scared cat,scaredcat

# ==== DB ====
DB_PATH=data/bot.db

# ==== Scheduler ====
DAILY_CHECK_HOUR_UTC=0
DAILY_CHECK_MINUTE_UTC=0
